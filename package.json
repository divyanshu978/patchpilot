{
  "name": "patchpilot-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PatchPilot — AI-powered PR reviewer for open-source maintainers",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force",
    "db:seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.0.1",
    "@octokit/rest": "^22.0.0",
    "@prisma/client": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "prisma": "^6.4.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
