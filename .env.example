# ---------------------------------------------------------------------------
# PatchPilot API configuration
# Copy to .env and fill in the values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://patchpilot:patchpilot@localhost:5432/patchpilot
POSTGRES_DB=patchpilot
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=patchpilot
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
# Prefer a file path so the private key is not copied into .env.
GITHUB_APP_PRIVATE_KEY_PATH=C:\path\to\your\github-app-private-key.pem
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_APP_SLUG=patchpilot

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completions endpoint)
# Examples:
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# CORS origin for the dashboard (future frontend)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000